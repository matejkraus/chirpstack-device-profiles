[
    {
        "name": "Measurement v2: documentation example (MAG event)",
        "input": {
            "fPort": 2,
            "bytes": [ 0x02, 0x01, 0x57, 0x01, 0x07, 0x2d, 0x04, 0x00, 0x00, 0x01, 0x2c, 0x00, 0x00, 0x00, 0x00 ]
        },
        "expected": {
            "data": {
                "version": 2,
                "event_flags": 1,
                "events": [
                    "MAG"
                ],
                "battery_level": 87,
                "temperature_c": 26.3,
                "humidity_rh": 45,
                "io_state": {
                    "in1": false,
                    "in2": false,
                    "mag": true
                },
                "in1_counter": 300,
                "in2_counter": 0
            }
        }
    },
    {
        "name": "Measurement v2: periodic, negative temperature, large counters",
        "input": {
            "fPort": 2,
            "bytes": [ 0x02, 0x00, 0x4b, 0xff, 0x79, 0x5a, 0x03, 0x80, 0x00, 0x00, 0x01, 0x00, 0x01, 0xe2, 0x40 ]
        },
        "expected": {
            "data": {
                "version": 2,
                "event_flags": 0,
                "events": [
                    "PERIODIC"
                ],
                "battery_level": 75,
                "temperature_c": -13.5,
                "humidity_rh": 90,
                "io_state": {
                    "in1": true,
                    "in2": true,
                    "mag": false
                },
                "in1_counter": 2147483649,
                "in2_counter": 123456
            }
        }
    },
    {
        "name": "Measurement v2: IN1 edge and temperature change",
        "input": {
            "fPort": 2,
            "bytes": [ 0x02, 0x44, 0x64, 0x00, 0xc8, 0x32, 0x01, 0x00, 0x00, 0x00, 0x0a, 0x00, 0x00, 0x00, 0x00 ]
        },
        "expected": {
            "data": {
                "version": 2,
                "event_flags": 68,
                "events": [
                    "IN1",
                    "TEMP"
                ],
                "battery_level": 100,
                "temperature_c": 20,
                "humidity_rh": 50,
                "io_state": {
                    "in1": true,
                    "in2": false,
                    "mag": false
                },
                "in1_counter": 10,
                "in2_counter": 0
            }
        }
    },
    {
        "name": "Measurement v1 (older firmware)",
        "input": {
            "fPort": 2,
            "bytes": [ 0x01, 0x00, 0x57, 0x01, 0x07, 0x2d, 0x00 ]
        },
        "expected": {
            "data": {
                "version": 1,
                "event_flags": 0,
                "events": [
                    "PERIODIC"
                ],
                "battery_level": 87,
                "temperature_c": 26.3,
                "humidity_rh": 45,
                "io_state": {
                    "in1": false,
                    "in2": false,
                    "mag": false
                }
            }
        }
    },
    {
        "name": "Degree-day day close",
        "input": {
            "fPort": 3,
            "bytes": [ 0x01, 0x00, 0x05, 0x00, 0x19, 0xff, 0xd8, 0x00, 0x50, 0x00, 0x00, 0x03, 0xe8 ]
        },
        "expected": {
            "data": {
                "version": 1,
                "day_index": 5,
                "daily_avg_c": 2.5,
                "daily_min_c": -4,
                "daily_max_c": 8,
                "degreeday_accum": 1000,
                "degreeday_accum_c": 100
            }
        }
    },
    {
        "name": "Config echo after setpoint 21.5 degC, heating on",
        "input": {
            "fPort": 12,
            "bytes": [ 0x01, 0x01, 0x2c, 0x00, 0x00, 0x5f, 0x00, 0xd7, 0x01, 0x00, 0x00, 0x30, 0x39, 0x00, 0x00, 0x03, 0xe8, 0x00, 0x00, 0x07, 0xd0 ]
        },
        "expected": {
            "data": {
                "version": 1,
                "tx_period_s": 300,
                "rejoin_period_h": 0,
                "event_enable_mask": 95,
                "event_enable": {
                    "mag": true,
                    "acc": true,
                    "in1": true,
                    "in2": true,
                    "btn2": true,
                    "temp": true
                },
                "target_temp_c": 21.5,
                "heating": true,
                "degreeday_accum": 12345,
                "degreeday_accum_c": 1234.5,
                "in1_counter": 1000,
                "in2_counter": 2000
            }
        }
    },
    {
        "name": "Measurement with unexpected length",
        "input": {
            "fPort": 2,
            "bytes": [ 0x02, 0x01, 0x57, 0x01, 0x07, 0x2d, 0x04 ]
        },
        "expected": {
            "errors": [
                "FPort 2: unexpected version 2 / length 7"
            ]
        }
    },
    {
        "name": "Unhandled fPort",
        "input": {
            "fPort": 1,
            "bytes": [ 0x01, 0x02, 0x03 ]
        },
        "expected": {
            "data": {},
            "warnings": [
                "unhandled fPort 1"
            ]
        }
    }
]
